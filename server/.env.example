# Copiar a .env (no se versiona) y ajustar. Nunca subir secretos reales.
DATABASE_URL=postgresql://usuario:password@localhost:5432/servicios_mainpc
SECRET_KEY=<cadena aleatoria larga para firmar JWT>
UPLOAD_DIR=./uploads
APP_ENV=production        # production | development
CORS_ORIGINS=["https://app.mainservicepc.com","https://clientes.mainservicepc.com"]
API_BASE_URL=https://api.mainservicepc.com

# URLs firmadas (HMAC) a fotos, firmas y PDFs: GET /api/files/signed?p=..&e=..&s=..
# OBLIGATORIO con APP_ENV=production: >= 32 caracteres y distinto de este ejemplo,
# si no la API no arranca. Generar con:  openssl rand -hex 32
# Cambiarlo invalida de inmediato todas las URLs firmadas vigentes (se re-emiten solas).
FILE_SIGNING_SECRET=cambiar-este-secreto
# Vigencia de cada URL firmada, en segundos (default 3600 = 1 h)
FILE_URL_TTL_SECONDS=3600
